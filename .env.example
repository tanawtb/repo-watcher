# Copy to .env and fill in. .env is gitignored; never commit real tokens or private repo names.

# PAT: classic with `repo` scope, or fine-grained with
# "Dependabot alerts: read-only" + "Code scanning: read-only" on the watched repos.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated owner/name list to watch.
REPOS=octo-org/web-app,octo-org/api-service

# GitHub API base. Change for GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3
GITHUB_API_BASE=https://api.github.com

# Local 24h times for automatic sweeps.
SWEEP_TIMES=09:30,15:30,17:30

# SQLite database file.
DB_PATH=repo_watcher.db

# Server bind.
HOST=127.0.0.1
PORT=8000
